<h1>Points of Contact List</h1>
<div class="Description">
<p>Records details of the individual curators receiving or curating the 3D scans.</p>
</div>
{{! READ table }}
<table>
    <thead>
        {{! For the table header row, we print the DB attribute names }}
        <tr>
            {{#each contacts.[0]}}
            <th>
                {{@key}}
            </th>
            {{/each}}
        </tr>
    </thead>

    <tbody>
        {{! For each row, print the id, fname, lname, homeworld and age }}
        {{#each contacts}}
        <tr>
            <td>{{this.ID}}</td>
            <td>{{this.[Contact Name]}}</td>
            <td>{{this.Email}}</td>
            <td>{{this.[Phone Number]}}</td>
            <td>{{this.Institution}}</td>
            <td>{{bool this.active}}</td>
        </tr>
        {{/each}}
    </tbody>
</table>
