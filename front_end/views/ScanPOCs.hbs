<h1>Scan'douts List</h1>
<div class="Description">
<p>The intersection table between Points Of Contact and 3D Scans to highlight the M:M relationship between them.<br> 
Specifically regarding the points of contact after the lab point of contact involving the 3d scans, where someone can<br>
request a 3D scan file as a loan. These are also called scan handouts, or: scan'douts!</p>
</div>
{{! READ table }}
<table>
    <thead>
        {{! For the table header row, we print the DB attribute names }}
        <tr>
            {{#each scancontacts.[0]}}
            <th>
                {{@key}}
            </th>
            {{/each}}
            <th></th>
        </tr>
    </thead>

    <tbody>
        {{! For each row, print the id, fname, lname, homeworld and age }}
        {{#each scancontacts}}
        <tr>
            <td>{{this.ID}}</td>
            <td>{{this.[Scan File]}}</td>
            <td>{{this.[Contact Email]}}</td>

            {{! DELETE form }}
            <form id="delete_scanPOC_form">
                <input type="hidden" name="delete_scanPOC_id" value="{{this.scanPOCID}}" />
                <td>
                    <input type="submit" value="Delete" />
                </td>
            </form>
        </tr>
        {{/each}}
    </tbody>
</table>

{{! CREATE form }}
<h2>Register a Scan'dout</h2>
<form class='cuForm' id='create_scanpoc_form'>

    <label for='create_scanpoc_POC'>Contact Point: </label>
    <select name='create_scanpoc_POC' id='create_scanpoc_POC'>
        <option value='NULL' selected>Select a Point of Contact</option>
        <option value='NULL'>&lt; None &gt;</option>
        {{#each pocs}}
        <option value='{{this.pocID}}' required>{{this.pocEmail}}</option>
        {{/each}}
    </select>

    <label for='create_scanpoc_3DScan'>Scan: </label>
    <select name='create_scanpoc_3DScan' id='create_scanpoc_3DScan'>
        <option value='NULL' selected>Select a Scan</option>
        <option value='NULL'>&lt; None &gt;</option>
        {{#each scans}}
        <option value='{{this.scanID}}' required>{{this.fileName}}</option>
        {{/each}}
    </select>

    <input type='submit' />
</form>

{{! UPDATE form }}
<h2>Update a Scan'dout</h2>
<form class='cuForm' id='update_scanPOC_form'>
    <label for='update_scanPOC_id'>Scan'dout to Update: </label>
    <select name='update_scanPOC_id' id='update_scanPOC_id' required>
        <option value='' disabled selected>Select a Scan'dout</option>
        {{#each scancontacts}}
        <option value='{{this.ID}}' required>
            {{this.ID}}
            -
            {{this.[Scan File]}}
             - loaned to - 
            {{this.[Contact Email]}}
        </option>
        {{/each}}
    </select>

    <label for='update_scan_ID'>Scan: </label>
    <select name='update_scan_ID' id='update_scan_ID'>
        <option value='NULL' disabled selected>Select a Scan</option>
        <option value='NULL'>&lt; None &gt;</option>
        {{#each scans}}
        <option value='{{this.scanID}}' required>
            {{this.scanID}}
            -
            {{this.fileName}}
        </option>
        {{/each}}
    </select>

    <label for='update_poc_ID'>POC: </label>
    <select name='update_poc_ID' id='update_poc_ID'>
        <option value='NULL' disabled selected>Select a POC</option>
        <option value='NULL'>&lt; None &gt;</option>
        {{#each pocs}}
        <option value='{{this.pocID}}' required>
            {{this.pocFName}}
            {{this.pocLName}}
            -
            {{this.pocEmail}}
        </option>
        {{/each}}
    </select>

    <input type='submit' />
</form>
