<h1>Technicians List</h1>
<div class="Description">
<p>Records the details of the technicians providing the 3D scans.</p>
</div>
{{! READ table }}
<table>
    <thead>
        {{! For the table header row, we print the DB attribute names }}
        <tr>
            {{#each technicians.[0]}}
            <th>
                {{@key}}
            </th>
            {{/each}}
        </tr>
    </thead>

    <tbody>
        {{! For each row, print the id, fname, lname, homeworld and age }}
        {{#each technicians}}
        <tr>
            <td>{{this.ID}}</td>
            <td>{{this.[Technician Name]}}</td>
            <td>{{this.[Email]}}</td>
            <td>{{this.[Phone Number]}}</td>
        </tr>
        {{/each}}
    </tbody>
</table>
