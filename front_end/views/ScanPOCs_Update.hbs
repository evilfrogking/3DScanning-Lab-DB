<h1>Update a Scan'dout</h1>

<p>
  <strong>ID:</strong> {{scanpoc.scanPOCID}}<br>
  <strong>File:</strong> {{scanpoc.File}}<br>
  <strong>Current Contact:</strong> {{scanpoc.Contact}}
</p>

<form class='cuForm' method='POST' action='/UpdateScanPOC'>
  <input type="hidden" name="update_scanPOC_id" value="{{scanpoc.scanPOCID}}">

  <label for="update_poc_ID">New Contact:</label>
  <select name="update_poc_ID" id="update_poc_ID" required>
    <option value="" disabled>Select a POC</option>
    {{#each pocs}}
      <option value="{{this.pocID}}" {{#if (eq this.pocID ../scanpoc.pocID)}}selected{{/if}}>
        {{this.pocFName}} {{this.pocLName}} - {{this.pocEmail}}
      </option>
    {{/each}}
  </select>

  <input type='submit' value="Update"/>
</form>
