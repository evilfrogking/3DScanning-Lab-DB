<h1>3D Scans</h1>
<div class="Description">
<p>Records the details of the 3D scans, including all potentially relevant research information.</p>
</div>
{{! READ table }}
<table>
    <thead>
        {{! For the table header row, we print the DB attribute names }}
        <tr>
            {{#each scans.[0]}}
            <th>
                {{@key}}
            </th>
            {{/each}}
        </tr>
    </thead>

    <tbody>
        {{! For each row, print the id, fname, lname, homeworld and age }}
        {{#each scans}}
        <tr>
            <td>{{this.ID}}</td>
            <td>{{this.[Scan Date]}}</td>
            <td>{{this.[File Name]}}</td>
            <td>{{this.[Artifact ID]}}</td>
            <td>{{this.[Technician Contact]}}</td>
            <td>{{this.[Lab Contact]}}</td>
            <td>{{this.Units}}</td>
            <td>{{this.[Scan Method]}}</td>
            <td>{{bool this.derived}}</td>
           
        </tr>
        {{/each}}
    </tbody>
</table>
